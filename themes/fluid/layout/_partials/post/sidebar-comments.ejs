<aside class="sidebar sidebar-comments" style="margin-left: -1rem">
  <div class="comments-header">
    <h4 class="comments-title">
      <i class="iconfont icon-comments"></i>
      <span>评论</span>
    </h4>
  </div>
  
  <div class="comments-scroll-container" id="comments-scroll-container">
    <div id="sidebar-twikoo"></div>
  </div>
  
  <div class="comments-input-area">
    <textarea 
      id="sidebar-comment-input" 
      class="comment-input" 
      placeholder="发表你的评论..." 
      maxlength="500"
    ></textarea>
    <div class="comment-actions">
      <span class="char-count">0/500</span>
      <button class="submit-comment" id="submit-comment-btn">发送</button>
    </div>
  </div>
</aside>