// 双重保障：CSS + JS 都确保手机端不显示弹幕横幅
.desktop-only
  display flex !important
  visibility visible !important
  opacity 1 !important
  
  @media (max-width: 1200px)
    display none !important
    visibility hidden !important
    opacity 0 !important
    height 0 !important
    overflow hidden !important
    position absolute !important
    left -9999px !important
  
  @media (max-width: 991px)
    display none !important
    visibility hidden !important
    opacity 0 !important
    height 0 !important
    overflow hidden !important
    position absolute !important
    left -9999px !important
  
  @media (max-width: 767px)
    display none !important
    visibility hidden !important
    opacity 0 !important
    height 0 !important
    overflow hidden !important
    position absolute !important
    left -9999px !important

.mobile-only
  display none !important
  visibility hidden !important
  opacity 0 !important
  
  @media (max-width: 1200px)
    display flex !important
    visibility visible !important
    opacity 1 !important
    flex-direction column
    align-items center
    justify-content center
  
  @media (max-width: 991px)
    display flex !important
    visibility visible !important
    opacity 1 !important
    flex-direction column
    align-items center
    justify-content center
  
  @media (max-width: 767px)
    display flex !important
    visibility visible !important
    opacity 1 !important
    flex-direction column
    align-items center
    justify-content center

// 同时直接确保弹幕容器在移动端完全隐藏
@media (max-width: 1200px)
  .banner-danmaku-wrapper
    display none !important
    visibility hidden !important
    opacity 0 !important
    height 0 !important
    overflow hidden !important
    position absolute !important
    left -9999px !important
  
  .banner-danmaku-container
    display none !important
  
  .danmaku-container
    display none !important

@media (max-width: 991px)
  .banner-danmaku-wrapper
    display none !important
    visibility hidden !important
    opacity 0 !important
    height 0 !important
    overflow hidden !important
    position absolute !important
    left -9999px !important
  
  .banner-danmaku-container
    display none !important
  
  .danmaku-container
    display none !important

@media (max-width: 767px)
  .banner-danmaku-wrapper
    display none !important
    visibility hidden !important
    opacity 0 !important
    height 0 !important
    overflow hidden !important
    position absolute !important
    left -9999px !important

.banner-danmaku-wrapper
  width 100%
  height 100%
  display flex
  align-items center
  justify-content center
  padding 2rem
  box-sizing border-box

.banner-danmaku-container
  width 100%
  display flex
  align-items center
  justify-content center
  padding 0
  box-sizing border-box

.banner-danmaku-content
  width 100%
  max-width 800px
  max-height 85vh

.danmaku-container
  width 100%
  background rgba(0, 0, 0, 0.4)
  backdrop-filter blur(15px)
  border-radius 1rem
  padding 1.25rem
  box-shadow 0 4px 30px rgba(255, 152, 0, 0.15)
  border 1px solid rgba(255, 152, 0, 0.25)
  box-sizing border-box
  position relative

.danmaku-header
  display flex
  justify-content space-between
  align-items center
  margin-bottom 1rem
  padding-bottom 0.625rem
  border-bottom 1px solid rgba(255, 152, 0, 0.2)

.danmaku-title
  font-size 1.125rem
  font-weight 600
  color #00bcd4
  text-shadow: 0 0 6px rgba(0, 188, 212, 0.5)
  margin 0

.danmaku-scroll-btn
  display inline-flex
  align-items center
  gap 4px
  padding 6px 14px
  font-size 14px
  color #fff
  background #ff0000
  border none
  border-radius 18px
  cursor pointer
  transition all 0.2s ease
  white-space nowrap
  font-family -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
  user-select none

  &:hover
    background #cc0000
    transform translateY(-1px)

.scroll-btn-img
  width 18px
  height 18px
  vertical-align middle
  object-fit contain

.scroll-btn-text
  font-size 14px

.danmaku-exit-btn
  padding 0.375rem 0.75rem
  font-size 0.75rem
  color #ff4757
  background rgba(255, 71, 87, 0.1)
  border 1px solid #ff4757
  border-radius 0.25rem
  cursor pointer
  transition all 0.2s ease

  &:hover
    background rgba(255, 71, 87, 0.2)

.admin-mode .danmaku-title
  color #ff4757

.danmaku-list
  height 12rem
  overflow hidden
  position relative
  margin-bottom 1rem
  border-radius 0.5rem
  background transparent

.danmaku-inner
  animation danmakuScroll 12s linear infinite
  will-change transform

@keyframes danmakuScroll
  0%
    transform translateY(0)
  100%
    transform translateY(-50%)

.danmaku-item
  display flex
  align-items center
  justify-content space-between
  padding 0.75rem 0.875rem
  margin-bottom 0.5rem
  background rgba(255, 152, 0, 0.12)
  border-radius 0.5rem
  transition all 0.2s ease
  cursor pointer

  &:hover
    background rgba(255, 152, 0, 0.2)

.danmaku-content
  font-size 0.875rem
  color #ff9800
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  display flex
  align-items center
  gap 4px

.danmaku-location
  display none

.comment-emoji
  width 24px
  height 24px
  vertical-align middle
  display inline-block

.danmaku-actions
  display flex
  align-items center
  gap 0.625rem

.danmaku-like
  display flex
  align-items center
  gap 0.3125rem
  color #ff9800
  font-size 0.8125rem
  padding 0.3125rem 0.625rem
  border-radius 2rem
  transition all 0.2s ease
  cursor pointer

  &:hover
    color #ff9800
    background rgba(255, 152, 0, 0.1)

  &.liked
    color #ff9800
    background rgba(255, 152, 0, 0.15)

  i
    font-size 1rem

.danmaku-delete
  font-size 0.7rem
  color #ff4757
  padding 0.3125rem 0.625rem
  border-radius 0.3125rem
  transition all 0.2s ease
  cursor pointer

  &:hover
    background rgba(255, 71, 87, 0.1)

.like-count
  min-width 1rem
  text-align center

.danmaku-input-area
  padding-top 0.625rem

.input-group
  display flex
  gap 0.625rem
  align-items center

.emoji-picker-wrapper
  position relative
  display inline-flex
  align-items center

.emoji-btn
  width 40px
  height 40px
  background rgba(255, 152, 0, 0.1)
  border 1px solid rgba(255, 152, 0, 0.3)
  border-radius 50%
  cursor pointer
  transition all 0.15s ease
  display flex
  align-items center
  justify-content center
  overflow hidden

  &:hover
    background rgba(255, 152, 0, 0.2)
    transform scale(1.1)

.emoji-btn-img
  width 26px
  height 26px
  object-fit contain

.emoji-picker
  position absolute
  top 4.5rem
  left 1.25rem
  right 1.25rem
  bottom 8rem
  background rgba(255, 255, 255, 0.85)
  backdrop-filter blur(10px)
  border none
  border-radius 0.5rem
  padding 0.5rem
  overflow hidden
  z-index 500
  display none
  animation fadeIn 0.2s ease
  -ms-overflow-style none
  scrollbar-width none
  box-sizing border-box

  &.show
    display block

  &::-webkit-scrollbar
    width 0
    height 0
    display none

  &::-webkit-scrollbar-track
    background transparent

  &::-webkit-scrollbar-thumb
    background transparent

@keyframes fadeInUp
  0%
    opacity 0
    transform translateY(8px)
  100%
    opacity 1
    transform translateY(0)

.emoji-grid
  display grid
  grid-template-columns repeat(16, 1fr)
  grid-auto-rows minmax(0, 1fr)
  gap 2px
  width 100%
  height 100%
  box-sizing border-box
  align-content start

.emoji-item
  width 100%
  height 100%
  display flex
  align-items center
  justify-content center
  cursor pointer
  border-radius 2px
  transition all 0.15s ease
  overflow hidden
  padding 0px
  box-sizing border-box
  aspect-ratio 1

  &:hover
    background transparent
    transform scale(1.15)

  img
    width 100%
    height 100%
    object-fit contain

.danmaku-input
  flex 1
  height 2.75rem
  padding 0.625rem 1.125rem
  font-size 0.875rem
  border 1px solid rgba(255, 152, 0, 0.4)
  border-radius 2rem
  background rgba(255, 255, 255, 0.1)
  color #ff9800
  outline none
  transition all 0.2s ease

  &:focus
    border-color #ff9800
    box-shadow 0 0 0 3px rgba(255, 152, 0, 0.2)

  &::placeholder
    color rgba(255, 152, 0, 0.8)

.danmaku-submit
  height 2.75rem
  padding 0 1.5rem
  font-size 0.875rem
  font-weight 500
  color #fff
  background #ff0000
  border none
  border-radius 2rem
  cursor pointer
  transition all 0.2s ease
  white-space nowrap

  &:hover
    transform translateY(-2px)
    box-shadow 0 4px 12px rgba(255, 0, 0, 0.4)
    background #cc0000

  &:active
    transform translateY(0)

.danmaku-footer
  margin-top 0.75rem
  padding-top 0.75rem
  border-top none
  text-align center
  display flex
  flex-direction column
  justify-content center
  gap 0.5rem

.danmaku-author
  font-size 14px
  color #00bcd4
  text-shadow: 0 0 4px rgba(0, 188, 212, 0.5)
  line-height 1.6
  text-align center
  display block

.danmaku-powered
  font-size 15px
  color #00bcd4
  text-shadow: 0 0 4px rgba(0, 188, 212, 0.5)
  line-height 1.6
  text-align center
  
  a
    color #00bcd4
    text-shadow: 0 0 4px rgba(0, 188, 212, 0.5)
    text-decoration none
    font-size 15px
    
    &:hover
      color #00acc1
      text-decoration none
  
  i
    color #00bcd4
    text-shadow: 0 0 4px rgba(0, 188, 212, 0.5)

.danmaku-version
  font-size 14px
  color #ff9800
  line-height 1.6
  text-align center
  display block

@media (max-width: 767px)
  .banner-danmaku-wrapper
    display none !important
    visibility hidden !important
    opacity 0 !important
    height 0 !important
    overflow hidden !important
    position absolute !important
    left -9999px !important
  
  .banner-danmaku-container
    display none !important
  
  .danmaku-container
    display none !important

  .danmaku-version
    font-size 11px
    line-height 1.4
    display block
    white-space normal

@media (max-width: 480px)
  .banner-danmaku-wrapper
    display none !important
    visibility hidden !important
    opacity 0 !important
    height 0 !important
    overflow hidden !important
    position absolute !important
    left -9999px !important
  
  .banner-danmaku-container
    display none !important
  
  .danmaku-container
    display none !important

  .danmaku-version
    font-size 10px
    line-height 1.3
    display inline
    white-space normal